# URL pública do site (sem barra no final). Usada em canonical, sitemap, OG e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.marcelomaschke.com.br

# Google Analytics 4 (opcional). Só carrega após o visitante aceitar os cookies.
NEXT_PUBLIC_GA_ID=

# Resend — envio do formulário de pré-agendamento (somente no servidor, nunca exposto ao navegador).
RESEND_API_KEY=
# E-mail que recebe os pedidos do formulário.
BOOKING_TO_EMAIL=
# Remetente verificado no Resend. Ex.: Site Marcelo Maschke <site@marcelomaschke.com.br>
BOOKING_FROM_EMAIL=
